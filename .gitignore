# Terraform local cache — downloaded providers and modules
.terraform/

# Terraform state files — state is managed remotely in HCP Terraform Cloud
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info

# Terraform plan output files — contain sensitive data, never commit
*.tfplan

# Terraform variable files — may contain secrets (project_id, etc.)
*.tfvars
*.tfvars.json

# Terraform lock file — optionally commit this to pin provider versions
# Uncomment the line below to exclude it
# .terraform.lock.hcl

# Cloud Function build artifact — regenerated by Terraform at apply time
function.zip

# GCP service account key files — never commit credentials
*-key.json
credentials.json
service-account*.json

# Python cache
__pycache__/
*.pyc
.python_packages/

# macOS metadata files
.DS_Store

# Editor directories
.idea/
.vscode/

# Environment variable files — may contain GCP credentials or tokens
.env
.env.*
